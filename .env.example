# Placeholder values only. Copy to .env (gitignored) and fill locally; never commit credentials.
# Set to your local Postgres DSN. Example format only — replace USER/PASSWORD locally.
DE_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/data_engine
DE_ARTIFACT_ROOT=./var/artifacts
DE_LOG_LEVEL=INFO
DE_LOG_FORMAT=json
DE_WORKER_SLOTS=auto
DE_API_HOST=127.0.0.1
DE_API_PORT=8000
# Optional Hugging Face token for public/private dataset downloads.
HF_KEY=

# Optional Gemini API key for Gemini model usage.
GEMINI_API_KEY=
