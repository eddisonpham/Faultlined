# Copy to .env (gitignored) and edit locally. Placeholders only, never real credentials.

# Required: your PostgreSQL address.
# The `just pg-up` cluster: postgresql://data_engine@127.0.0.1:55432/data_engine
DE_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/data_engine

# Where generated files go. Safe to delete at any time.
DE_ARTIFACT_ROOT=./var/artifacts
DE_EXPORT_ROOT=./var/exports
DE_METRICS_PATH=./var/metrics/runtime.jsonl

# API and logging.
DE_API_HOST=127.0.0.1
DE_API_PORT=8000
DE_LOG_LEVEL=INFO
DE_LOG_FORMAT=json

# Optional: worker concurrency. `auto`, or cpu=N,gpu=N.
DE_WORKER_SLOTS=auto

# Optional: Hugging Face token, only for private dataset downloads.
HF_KEY=